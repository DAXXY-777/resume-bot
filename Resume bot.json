      "id": "2bc01e94-cbb7-458e-9f6f-92129c71e1f0",
      "name": "Google Drive - Download Resume",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        -608,
        560
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "YRJCAipIp7lCK87G",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.output;\n\nconst result =\n  typeof raw === 'string'\n    ? JSON.parse(raw)\n    : raw;\n\n// Get metadata from Google Drive search\nconst file = $('Google Drive - Download Resume').first().json;\n\n// Filename\nresult.FileName = file.name || 'resume.pdf';\n\n// Construct Google Drive link using the file ID\nresult.FileLink = file.id\n  ? `https://drive.google.com/file/d/${file.id}/view`\n  : '';\n\n// Make score numeric\nconst score = Number(result.total_score ?? 0);\nresult.total_score = score;\n\n// Route candidate\nif (score >= 65) {\n  result.route = 'passed';\n} else if (score >= 40) {\n  result.route = 'needs_review';\n} else {\n  result.route = 'failed';\n}\n\nreturn [{ json: result }];\n$('Google Drive - Download Resume').first().json.id"
      },
